# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONNECTION (Optional: leave empty to use the built-in SQLite API server)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# OPTIONAL API BASE URL (Only needed if a standalone WebView/static frontend calls a separate backend origin)
VITE_API_BASE_URL=""
